{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "quick-knowledge",
  "version": "1.1.0",
  "description": "Personal Knowledge Base × AI Skill Framework — distill fragmented information into reusable personal assets. Six closed loops + 3 agents (manager / research / memory).",
  "owner": {
    "name": "shichu2024",
    "url": "https://github.com/shichu2024"
  },
  "publisher": "shichu2024",
  "homepage": "https://github.com/shichu2024/quick-knowledge",
  "repository": {
    "type": "git",
    "url": "https://github.com/shichu2024/quick-knowledge.git"
  },
  "license": "MIT",
  "tags": [
    "knowledge-management",
    "agent-skills",
