    "v0.1": { "codename": "mvp", "status": "released" },
    "v0.2": { "codename": "loops", "status": "released" },
    "v0.3": { "codename": "assistant", "status": "released" },
    "v0.4": { "codename": "extensions", "status": "released" },
    "v1.0": { "codename": "release", "status": "released" },
    "v1.1": { "codename": "flow-restructure", "status": "released" }
  },
  "install": {
    "one_liner": "npx skills add shichu2024/quick-knowledge",
    "claude_code": "/plugin marketplace add shichu2024/quick-knowledge",
    "manual_paths": {
      "claude-code": "~/.claude/skills/quick-knowledge/",
      "codex": "~/.codex/skills/quick-knowledge/",
