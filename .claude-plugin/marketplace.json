    "claude-code",
    "obsidian",
    "zettelkasten"
  ],
  "runtimes": [
    "claude-code",
    "codex",
    "cursor",
    "opencode"
  ],
  "plugins": [
    {
      "name": "quick-knowledge",
      "description": "Personal Knowledge Base × AI Skill Framework. 14 skills (Capture/Ingest/Normalize/Connect/Query/Review/Advisor/Project/Goal/Archive/Stats/Import + Init/Daily) + 3 agents (manager/research/memory). Six closed loops distill fragmented info into reusable cognitive assets.",
      "displayName": "quick-knowledge",
      "author": {
        "name": "shichu2024",
        "url": "https://github.com/shichu2024"
      },
      "category": "productivity",
      "source": "./",
      "homepage": "https://github.com/shichu2024/quick-knowledge",
      "license": "MIT",
      "tags": [
        "knowledge-management",
        "agent-skills",
        "personal-knowledge-base",
        "obsidian"
      ]
    }
  ],
  "skills": [
    { "name": "quick-kb-init", "path": "skills/quick-kb-init/" },
    { "name": "quick-kb-capture", "path": "skills/quick-kb-capture/" },
    { "name": "quick-kb-ingest", "path": "skills/quick-kb-ingest/" },
    { "name": "quick-kb-daily", "path": "skills/quick-kb-daily/" },
    { "name": "quick-kb-connect", "path": "skills/quick-kb-connect/" },
    { "name": "quick-kb-query", "path": "skills/quick-kb-query/" },
    { "name": "quick-kb-review", "path": "skills/quick-kb-review/" },
    { "name": "quick-kb-advisor", "path": "skills/quick-kb-advisor/" },
    { "name": "quick-kb-project", "path": "skills/quick-kb-project/" },
    { "name": "quick-kb-goal", "path": "skills/quick-kb-goal/" },
    { "name": "quick-kb-normalize", "path": "skills/quick-kb-normalize/" },
    { "name": "quick-kb-archive", "path": "skills/quick-kb-archive/" },
    { "name": "quick-kb-stats", "path": "skills/quick-kb-stats/" },
    { "name": "quick-kb-import", "path": "skills/quick-kb-import/" }
  ],
  "agents": [
    { "name": "quick-kb-manager-agent", "path": "agents/quick-kb-manager-agent.md" },
    { "name": "quick-kb-research-agent", "path": "agents/quick-kb-research-agent.md" },
    { "name": "quick-kb-memory-agent", "path": "agents/quick-kb-memory-agent.md" }
